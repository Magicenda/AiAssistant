# LLM-провайдер: gigachat (по умолчанию) или openai_compatible (Ollama / LM Studio)
LLM_PROVIDER=gigachat

# SQLite для локального запуска или Postgres для production
# DATABASE_URL=sqlite+aiosqlite:///./assistant.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_assistant

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=false

# openai_compatible (Ollama / LM Studio); используется при LLM_PROVIDER=openai_compatible
# Ollama:    http://localhost:11434/v1, ключ ollama
# LM Studio: http://localhost:1234/v1,  ключ lm-studio
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Минимум 32 символа: openssl rand -hex 32
JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
