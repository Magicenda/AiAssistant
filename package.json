{
  "name": "ai-assistant",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "start:web": "bun run --cwd apps/web start",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "lint:web": "bun run --cwd apps/web lint",
    "format:web": "bun run --cwd apps/web format",
    "format:check:web": "bun run --cwd apps/web format:check",
    "test:web": "bun run --cwd apps/web test",
    "sync:api": "uv sync --directory apps/api",
    "dev:api": "uv run --directory apps/api uvicorn app:app --app-dir src --reload",
    "start:api": "uv run --directory apps/api uvicorn app:app --app-dir src"
  }
}
