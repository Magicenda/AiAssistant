# Единый env монорепы: его читают и frontend (apps/web), и backend (apps/api).
# Скопируйте в корень и заполните секреты:
#   cp .env.example .env
# Файл в .gitignore — секреты не коммитим.

# --- Frontend (apps/web) ---
# Адрес backend API. Инлайнится в бандл при сборке, по умолчанию
# http://localhost:8000. Меняется только здесь.
# В проде укажите публичный адрес nginx, например https://ai.example.com:
# тогда браузер ходит в /api/... того же домена, а nginx проксирует в backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (apps/api) ---
# В Docker эти значения перекрывает docker-compose.yml:
# DATABASE_URL, LLM_BASE_URL, JWT_SECRET — см. комментарии в нём.

# База данных: Postgres из docker-compose (порт 5434) или SQLite без Docker.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/ai_assistant
# DATABASE_URL=sqlite+aiosqlite:///./assistant.db

# JWT: минимум 32 символа: openssl rand -hex 32
JWT_SECRET=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM: gigachat (по умолчанию) или openai_compatible (Ollama / LM Studio)
LLM_PROVIDER=gigachat

# GigaChat: ключ авторизации из личного кабинета.
# Остальное — дефолты из apps/api/src/core/config.py, раскомментируйте,
# если нужны другие значения.
GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_VERIFY_SSL_CERTS=false

# openai_compatible; используется при LLM_PROVIDER=openai_compatible
# Ollama:    http://localhost:11434/v1, ключ ollama
# LM Studio: http://localhost:1234/v1,  ключ lm-studio
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_TIMEOUT=120
# GIGACHAT_MAX_RETRIES=1

# Whisper: оптимальный локальный профиль для CPU и 8 ГБ RAM.
# WHISPER_MODEL_SIZE=small
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_BEAM_SIZE=1
# WHISPER_MAX_CONCURRENT=1
# WHISPER_VAD_MIN_SILENCE_MS=500

# Агент: сколько шагов на запрос и сколько сообщений истории отдавать модели.
# AGENT_MAX_STEPS=5
# HISTORY_LIMIT=20

# --- Docker Compose (подстановки ${...} из этого же файла) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ai_assistant
# POSTGRES_PORT=5434
# API_PORT=8000
# WEB_PORT=3000
# Публичный порт nginx. В проде — 80; поставьте другой, если 80 занят
# или TLS терминируется внешним прокси.
# HTTP_PORT=80
